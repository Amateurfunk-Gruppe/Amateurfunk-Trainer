# Abhaengigkeiten - gehoeren nicht ins Repository, kommen per "npm install"
node_modules/

# Geheimnisse - niemals ins Repository
.env
.env.local
.env.*.local

# Laufzeit-Dateien und Logs
tts_cache/
tunnel.log
tunnel_out.log
tunnel_url.txt
*.log
npm-debug.log*
yarn-error.log*

# Persoenliche Lerndaten - nichts fuer ein Repository
data/
*.bak
*.tmp
*.defekt-*

# Grosse Binaerdateien, werden bei Bedarf heruntergeladen
cloudflared.exe
piper/
*.exe
*.dll
*.onnx
*.onnx.json

# Alte Codestaende und Sicherungen - dafuer ist ab jetzt die Git-Historie da.
#
# ACHTUNG, hier lag der Fehler: Bisher stand hier "backup_*/" mit
# Unterstrich. Der Ordner heisst aber schlicht "backup/" - er war damit
# NICHT ausgenommen, und backup/amateurfunk_data.json (der Lernstand) lag
# im Repository. Aufgefallen ist es erst bei der Pruefung vor dem
# Hochladen.
original/
backup/
backup_*/

# Gesicherte Lernstaende ("Sichern" im Trainer). Persoenliche Daten -
# und jederzeit neu erzeugbar.
Klasse-N-Lernstand_*.json
Amateurfunk-Lernstand_*.json

# Test-/Build-Artefakte
coverage/
*.pid

# Editor-/IDE-Ordner
.vscode/
.idea/

# Betriebssystem
Thumbs.db
desktop.ini
.DS_Store

Node.js/
*.msi

# Hoerbuch: fertige MP3s fuer den USB-Stick. Bei allen Fragen rund 70 MB -
# und jederzeit neu erzeugbar, also nichts fuer die Versionsgeschichte.
Hoerbuch/

# Ergebnis von Aufraeumen.bat - liegt nur so lange da, bis geprueft ist,
# dass der Trainer auch ohne die Dateien laeuft. Nichts fuer die Historie.
_Aufgeraeumt_*/

# Die alte Historie, von GitHub-Neustart.bat zur Seite gelegt.
#
# OHNE DIESE ZEILE WAERE DER GANZE NEUSTART UMSONST: "git add -A" nimmt
# den Ordner sonst als gewoehnliche Dateien mit auf - samt der alten
# Objekte, in denen der Lernstand steckt. Beim ersten Test ist genau das
# passiert, 46 statt 40 Dateien im ersten Commit.
.git_alt_*/

# Ergebnis von Stimmen_packen.bat - der Anhang fuers Release, rund 470 MB.
#
# Er liegt bewusst im Hauptordner, denn dort findet man ihn zum Hochladen.
# Mitcommittet werden darf er unter keinen Umstaenden: GitHub weist jede
# Datei ueber 100 MiB zurueck - und zwar erst, nachdem alles uebertragen
# wurde. Ohne diese Zeile waere der Ordner eine Falle, die ich selbst
# aufgestellt haette.
Piper-Stimmen.zip

# Merkposten des GitHub-Updaters. Er haelt fest, wie die Dateien aussahen,
# als sie zuletzt mit GitHub gleich waren, und schuetzt so frisch
# geschriebene Dateien davor, von einer aelteren Fassung ueberschrieben zu
# werden. Das ist der Zustand DIESES Rechners - er gehoert niemandem sonst.
github_stand.json

# Wer das eingebettete Videofenster sehen darf. Enthaelt Vornamen echter
# Menschen, die nie gefragt wurden, ob sie im Netz auftauchen wollen -
# und genau deshalb steht die Liste seit dem 26.08.2026 in dieser Datei
# und nicht mehr im Klartext in Index.html.
video_embed.json

# --- Werkzeuge, die nur auf dem Entwicklerrechner Sinn ergeben ---
#
# Sie liegen weiter im Ordner und funktionieren. Sie gehoeren nur
# nicht in ein Repository, das andere herunterladen, um zu lernen.
#
# ACHTUNG, hier lag am 26.08.2026 ein Fehler von mir: GitHub-Ausmisten.bat
# hatte diesen Block schon angelegt - und dann habe ich eine .gitignore
# aus meiner eigenen Fassung darueber geschrieben und ihn dabei geloescht.
# Die dreizehn Werkzeuge standen daraufhin wieder zum Hochladen bereit.
# Seither steht der Block auch in meiner Fassung, damit er ein Ueber-
# schreiben ueberlebt.
#
# NICHT dabei: github_update.js - das gehoert zum Trainer und wird von
# Server.js gebraucht. Und Update-Pruefen.bat / update_pruefen.js, die
# braucht der Gast in SEINEM Ordner.
Hochladen.bat
hochladen.js
GitHub-Neustart.bat
github_neustart.js
GitHub-Pruefen.bat
github_pruefen.js
GitHub-Ausmisten.bat
github_ausmisten.js
Stimmen_packen.bat
stimmen_packen.js
Aufraeumen.bat
aufraeumen.js
commit.bat
#
# Kein Werkzeug, aber genauso wenig fuer die Oeffentlichkeit: die
# Innenrevision vom 17.08.2026. Sie beschreibt einen Codestand, den es so
# nicht mehr gibt, und nennt einmal den Pfad des Windows-Benutzerkontos.
BUG_REPORT.md
#
# Die Anleitung zu den GitHub-Einstellungen. Sie ist fuer Dietmar am
# Rechner gedacht, nicht fuer Besucher des Repositorys - sie beschreibt,
# wo man klickt, nicht was der Trainer kann.
GITHUB-Einstellungen.md
#
# --- Das mitgelieferte Node.js ---
#
# node.exe allein ist rund 90 MB. Das ist zwar knapp unter GitHubs
# Grenze von 100 MiB, gehoert aber trotzdem nicht ins Repository:
# Jeder, der klont, zoege es mit, und es gilt nur fuer Windows x64 -
# Mac und Linux koennen damit nichts anfangen. Wer es braucht, holt es
# sich in zwei Minuten mit Node-Holen.bat.
node/
node_alt_*/

# --- Der Ordner "Mitnehmen" ---
#
# Angelegt am 27.08.2026, als der Trainer-Ordner neu aufgesetzt wurde:
# Darin liegt alles, was NICHT bei GitHub ist und beim Loeschen des
# Ordners verlorenginge - Werkzeuge, private Listen, Merkposten.
# Genau deshalb hat er im Repository nichts zu suchen.
Mitnehmen/
