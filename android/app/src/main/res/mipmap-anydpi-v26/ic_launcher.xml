<?xml version="1.0" encoding="utf-8"?>
<!-- App-Symbol: Maja mit Raketenantrieb im Weltraum (29.10.2026, Entwurf C, von Dietmar freigegeben).
     Hintergrund = Nachtblau mit Sternen (ic_hintergrund_maja), Vordergrund = Maja (ic_vorne_maja);
     Android schneidet die Form (Kreis, Quadrat, Blatt) selbst zu, die Figur laeuft ueber den Rand.
     Vorher: die winkende Astronautin (06.10.2026), davor Funki (ic_vorne.xml bleibt liegen). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_hintergrund_maja" />
    <foreground android:drawable="@drawable/ic_vorne_maja" />
</adaptive-icon>
